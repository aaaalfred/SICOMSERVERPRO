	async postDBTablesSyncS3(req, connection, res, database) {
		try {
			let valuesRequest = JSON.parse(JSON.stringify(req));
			let arrInserts = [];
			let contPhotos = 0;

			for (const e of valuesRequest) {
				for (const tableWithDatas in e) {
					if (e.hasOwnProperty(tableWithDatas)) {
						console.log("TABLE", tableWithDatas);

						for (const fields of e[tableWithDatas]) {
							let valuesInsert = "";
							let values = "";
							let sql;

							if (parseInt(fields["id"]) > 0) {
								// UPDATE
								if (tableWithDatas !== "actividades") {
									for (const field in fields) {
										if (field !== "id") {
											values += ` ${field} = '${fields[field]}',`;
										}
									}
									sql = `UPDATE ${tableWithDatas} SET ${values.slice(
										0,
										-1
									)} WHERE id = ${fields["id"]};`;
								} else {
									sql = `UPDATE actividades 
                         SET fecha_f = '${fields["fecha_f"]}', 
                             c_x_f = ${fields["c_x_f"]}, 
                             c_y_f = ${fields["c_y_f"]}, 
                             incidenciaE = '${fields["incidenciaE"]}' 
                       WHERE id = ${fields["id"]}`;
								}
							} else {
								// INSERT dinámico
								for (const field in fields) {
									// si es id vacío → lo ignoramos
									if (field === "id" && (!fields[field] || fields[field] === "")) {
										continue;
									}

									values += field + ",";

									if (
										field.endsWith("F") &&
										fields[field] &&
										fields[field].length > 10
									) {
										// --- SUBIR IMAGEN A S3 ---
										const nombre_imagen = `${tableWithDatas}-${fields["usuario_id"]}-${Date.now()}.jpeg`;

										const urlBackend =
											"http://mctree.mx:8000/sicom/generate-upload-url";

										const urlResponse = await axios.get(urlBackend, {
											params: {
												file_name: nombre_imagen,
												project: database,
											},
										});

										if (!urlResponse.data || !urlResponse.data.presigned_url) {
											throw new Error("No se pudo obtener presigned URL");
										}

										const presignedUrl = urlResponse.data.presigned_url;
										const publicUrl =
											urlResponse.data.public_url ||
											`/${database}/${nombre_imagen}`;

										const buffer = Buffer.from(fields[field], "base64");

										const uploadResp = await axios.put(presignedUrl, buffer, {
											headers: {
												"Content-Type": "image/jpeg",
												"Content-Length": buffer.length,
											},
										});

										if (uploadResp.status !== 200) {
											throw new Error("Error al subir imagen a S3");
										}

										console.log("Imagen subida correctamente:", publicUrl);
										contPhotos++;
										valuesInsert += `'${publicUrl}',`;
									} else {
										valuesInsert += `'${fields[field]}',`;
									}
								}

								sql = `INSERT INTO ${tableWithDatas} (${values.slice(
									0,
									-1
								)}) VALUES (${valuesInsert.slice(0, -1)});`;
							}

							arrInserts.push(sql);
						}
					}
				}
			}

			console.log("Total de fotos subidas a S3:", contPhotos);

			// Ejecutar inserts/updates en serie
			for (const insert of arrInserts) {
				await new Promise((resolve, reject) => {
					connection.query(insert, (err, result) => {
						if (err) reject(err);
						else resolve(result);
					});
				});
			}

			connection.end();
			res.send("completado");
		} catch (err) {
			console.error("Error en postDBTablesSyncS3:", err);
			res.status(500).json({ error: err.message });
		}
	}



